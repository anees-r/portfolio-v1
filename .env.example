# Nezden's database (read-only consumer; content is edited in Nezden's CMS).
# Copy to .env.local and fill in. The `options` parameter makes every transaction read-only.
# If the URL already has query params (e.g. ?sslmode=require), join with & instead of ?.
NEZDEN_DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/nezden?options=-c%20default_transaction_read_only%3Don
# Public base for uploaded media (images are served by Nezden)
NEZDEN_MEDIA_BASE=https://nezden.com/media
